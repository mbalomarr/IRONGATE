# Copy to .env and adjust.
APP_NAME="Iron Gate API"
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./irongate.db
# Production target (MySQL 8, utf8mb4 is required for Arabic text):
# DATABASE_URL=mysql+pymysql://irongate:irongate@localhost:3306/irongate?charset=utf8mb4
DB_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["*"]

DEFAULT_LOCALE=en

# Mock Shamoos behaviour
SHAMOOS_MOCK_APPROVAL_RATE=0.8
SHAMOOS_MOCK_FAILURE_RATE=0.0

# SLA penalty job
SLA_JOB_ENABLED=true
SLA_JOB_INTERVAL_SECONDS=300
SLA_BREACH_THRESHOLD_MINUTES=30
SLA_DEFAULT_PENALTY_AMOUNT=500.00
PLATFORM_COMMISSION_RATE=0.10

# Initial super admin created by `python -m app.db.seed`
SEED_ADMIN_EMAIL=admin@irongate.sa
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_NAME="Platform Admin"
